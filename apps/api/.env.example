# Runtime role: NOT the table owner and NO BYPASSRLS — Row-Level Security always applies.
DATABASE_URL=postgres://orbit_app:orbit_app_dev@localhost:5432/orbit
# Platform admin panel only (BYPASSRLS). Used for cross-business aggregates.
DATABASE_ADMIN_URL=postgres://orbit_admin:orbit_admin_dev@localhost:5432/orbit
# Schema owner, used only by `npm run db:migrate` and `npm run db:seed`.
DATABASE_MIGRATION_URL=postgres://orbit_migrator:orbit_migrator_dev@localhost:5432/orbit
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Comma-separated origins allowed to call the API.
WEB_ORIGIN=http://localhost:3000
# Base URL of public business pages, e.g. https://orbit.app
PUBLIC_BASE_URL=http://localhost:3000
# Google sign-in (optional). Create an OAuth client ID at console.cloud.google.com.
GOOGLE_CLIENT_ID=
# SMS for OTP: "dev" logs codes to the console. Add a DLT-registered provider for production.
SMS_PROVIDER=dev
# Development only: return the OTP in the API response so you can sign in without SMS.
OTP_DEV_ECHO=true
# Phone numbers (E.164, comma-separated) that become platform admins on first sign-in.
PLATFORM_ADMIN_PHONES=+919800000000
