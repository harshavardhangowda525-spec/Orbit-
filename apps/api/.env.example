# Runtime role: NOT the table owner and NO BYPASSRLS — Row-Level Security always applies.
DATABASE_URL=postgres://orbit_app:orbit_app_dev@localhost:5432/orbit
# Platform admin panel only (BYPASSRLS). Used for cross-business aggregates.
DATABASE_ADMIN_URL=postgres://orbit_admin:orbit_admin_dev@localhost:5432/orbit
# Schema owner, used only by `npm run db:migrate` and `npm run db:seed`.
DATABASE_MIGRATION_URL=postgres://orbit_migrator:orbit_migrator_dev@localhost:5432/orbit
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Comma-separated origins allowed to call the API.
WEB_ORIGIN=http://localhost:3000
# Base URL of public business pages, e.g. https://orbit.app
PUBLIC_BASE_URL=http://localhost:3000
# Google sign-in (optional). Create an OAuth client ID at console.cloud.google.com.
GOOGLE_CLIENT_ID=
# SMS for OTP: "dev" logs codes to the console. Add a DLT-registered provider for production.
SMS_PROVIDER=dev
# Development only: return the OTP in the API response so you can sign in without SMS.
OTP_DEV_ECHO=true
# Phone numbers (E.164, comma-separated) that become platform admins on first sign-in.
PLATFORM_ADMIN_PHONES=+919800000000

# ---------- Phase 2 ----------
# AI: "claude" (needs ANTHROPIC_API_KEY) or "fake" (offline demo brain: answers from FAQs, offers real slots).
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Thinking effort for customer chat: low keeps replies to a few seconds.
AI_EFFORT=low
# Background jobs: "bullmq" (Redis) or "inline" (tests). Set JOBS_ENABLED=false to run an API-only process.
JOBS_MODE=bullmq
JOBS_ENABLED=true
# Live updates across API instances: "redis" or "local".
REALTIME_MODE=redis
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts Power tokens. Required in production.
POWERS_ENCRYPTION_KEY=
# Google Calendar + Gmail Powers (OAuth client of type "Web application").
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/powers/oauth/callback
# Where the owner app lives (OAuth sends owners back here).
WEB_BASE_URL=http://localhost:3000
# Development only: messages to customers with no connected channel are logged as "sent" instead of skipped.
DEV_DELIVER=false
